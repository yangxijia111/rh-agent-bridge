# RunningHub API key（必填；官方 OpenAPI 鉴权用）
RUNNINGHUB_API_KEY=your-api-key-here

# RunningHub OpenAPI base URL（默认 https://www.runninghub.ai）
RUNNINGHUB_BASE_URL=https://www.runninghub.ai

# 默认 workflow id（可选，CLI 可用 --workflow-id 覆盖）
RUNNINGHUB_WORKFLOW_ID=

# Native ComfyUI 代理模式：standard（/proxy/<key>，24GB）| plus（/proxy-plus/<key>，48GB）
RUNNINGHUB_NATIVE_MODE=standard

# 浏览器兜底模式：host（输出结构化建议，由宿主智能体执行）| cdp（P2，暂未实现）
RH_BROWSER_MODE=host

# CDP 端点（仅 RH_BROWSER_MODE=cdp 时使用）
RH_CDP_URL=

# 日志级别：trace|debug|info|warn|error（默认 info）
RH_LOG_LEVEL=info
