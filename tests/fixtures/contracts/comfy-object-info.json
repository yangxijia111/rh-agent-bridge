      }
    },
    "output": ["IMAGE"],
    "name": "ImageUpscaleWithModel",
    "display_name": "Upscale Image (using Model)",
    "category": "image/upscaling",
    "output_node": false
  },
  "LoraLoader": {
    "input": {
      "required": {
        "lora_name": [["lora_a.safetensors", "lora_b.safetensors"]],
        "strength_model": ["FLOAT", { "default": 1 }],
        "strength_clip": ["FLOAT", { "default": 1 }],
        "model": ["MODEL"],
        "clip": ["CLIP"]
      }
    },
    "output": ["MODEL", "CLIP"],
    "name": "LoraLoader",
    "display_name": "Load LoRA",
    "category": "loaders",
    "output_node": false
  }
